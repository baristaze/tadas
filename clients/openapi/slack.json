{
  "components": {
    "schemas": {
      "SlackEventAnswerView": {
        "description": "Slack's check of the events URL gets its `challenge` back; every other\nevent is acknowledged with nothing.",
        "properties": {
          "challenge": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Challenge"
          }
        },
        "title": "SlackEventAnswerView",
        "type": "object"
      },
      "SlackInstallStartView": {
        "description": "Slack's own page, where a person approves the install for their\nworkspace. The link carries a one-time state, works once, until\n`expires_at`, and is shown here only: a replay under the same\nIdempotency-Key answers with `url` null, and the caller asks for another.",
        "properties": {
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          }
        },
        "required": [
          "url",
          "expires_at"
        ],
        "title": "SlackInstallStartView",
        "type": "object"
      },
      "SlackInstallationStatus": {
        "enum": [
          "ok",
          "broken"
        ],
        "title": "SlackInstallationStatus",
        "type": "string"
      },
      "SlackInstallationView": {
        "description": "The Slack workspace the org installed Tadas into, and the channel it\nposts to. `channel_id` is null until someone types `/tadas connect` in a\nchannel. `status` is `broken` when Slack refused for good (`broken_reason`\nsays which refusal): the channel is gone or the app is not in it, which a\nnew `/tadas connect` mends, or the token no longer renews, which a new\ninstall mends. `created_by` is the member who installed it. The bot token\nis never on the wire.",
        "properties": {
          "broken_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Broken Reason"
          },
          "channel_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Channel Id"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "created_by": {
            "format": "uuid",
            "title": "Created By",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/SlackInstallationStatus"
          },
          "team_id": {
            "title": "Team Id",
            "type": "string"
          },
          "team_name": {
            "title": "Team Name",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "team_id",
          "team_name",
          "channel_id",
          "status",
          "broken_reason",
          "created_by",
          "created_at",
          "updated_at"
        ],
        "title": "SlackInstallationView",
        "type": "object"
      },
      "SlackStatusView": {
        "description": "Whether the org has installed Tadas in Slack, and where.",
        "properties": {
          "installation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SlackInstallationView"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "installation"
        ],
        "title": "SlackStatusView",
        "type": "object"
      }
    }
  },
