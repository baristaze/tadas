{
  "components": {
    "schemas": {
      "AddFileRequest": {
        "additionalProperties": false,
        "description": "An upload to start: the file's name as the uploader had it, its type,\nand its size in bytes. The type must be one the purpose accepts and match\nthe name's extension; the size is the most the store will take.",
        "properties": {
          "content_type": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Content Type",
            "type": "string"
          },
          "name": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "size_bytes": {
            "exclusiveMinimum": 0.0,
            "title": "Size Bytes",
            "type": "integer"
          }
        },
        "required": [
          "name",
          "content_type",
          "size_bytes"
        ],
        "title": "AddFileRequest",
        "type": "object"
      },
      "FilePageView": {
        "description": "One page of files, oldest first. `next_cursor` fetches the next page and\nis null on the last one.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/FileView"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "FilePageView",
        "type": "object"
      },
      "FilePurpose": {
        "description": "Which context a file came from. The purpose decides the bounds an\nupload is held to and what `subject_id` names. A product adds a purpose\nper kind of file it keeps, with its bounds (`media.rules.BOUNDS`).",
        "enum": [
          "task_attachment",
          "voice_dictation",
          "task_import"
        ],
        "title": "FilePurpose",
        "type": "string"
      },
      "FileStatus": {
        "enum": [
          "pending",
          "stored"
        ],
        "title": "FileStatus",
        "type": "string"
      },
      "FileView": {
        "description": "A file the tenant keeps: its name, type, and size, never its bytes and\nnever where they live. `status` is `pending` until the upload is\nconfirmed, then `stored`.",
        "properties": {
          "content_type": {
            "title": "Content Type",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "created_by": {
            "format": "uuid",
            "title": "Created By",
            "type": "string"
          },
          "deleted_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deleted At"
          },
          "extension": {
            "title": "Extension",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "purpose": {
            "$ref": "#/components/schemas/FilePurpose"
          },
          "size_bytes": {
            "title": "Size Bytes",
            "type": "integer"
          },
          "status": {
            "$ref": "#/components/schemas/FileStatus"
          },
          "subject_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subject Id"
          }
        },
        "required": [
          "id",
          "name",
          "extension",
          "content_type",
          "size_bytes",
          "purpose",
          "subject_id",
          "status",
          "created_at",
          "created_by",
          "deleted_at"
        ],
        "title": "FileView",
        "type": "object"
      },
      "IssuedDownloadView": {
        "description": "A link to the file's bytes, straight from the store, that works until\n`expires_at`.",
        "properties": {
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url",
          "expires_at"
        ],
        "title": "IssuedDownloadView",
        "type": "object"
      },
      "IssuedPartView": {
        "description": "One part to send: the `size_bytes` bytes of the file from `offset`, as\nthe body of a PUT to `url`, straight to the store. The URL is signed for\nthat length, and the store refuses a body of any other.",
        "properties": {
          "number": {
            "title": "Number",
            "type": "integer"
          },
          "offset": {
            "title": "Offset",
            "type": "integer"
          },
          "size_bytes": {
            "title": "Size Bytes",
            "type": "integer"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "number",
          "offset",
          "size_bytes",
          "url"
        ],
        "title": "IssuedPartView",
        "type": "object"
      },
      "IssuedUploadView": {
        "description": "The parts of the upload the store does not hold yet, at most a window\nof them, each good until `expires_at`. `remaining` counts every part\nstill missing, these included: send these and ask again while it is\nabove zero, then confirm. Asked again after an upload was cut off, it\nsigns only the parts still missing, under the same `upload_id`.",
        "properties": {
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "parts": {
            "items": {
              "$ref": "#/components/schemas/IssuedPartView"
            },
            "title": "Parts",
            "type": "array"
          },
          "remaining": {
            "title": "Remaining",
            "type": "integer"
          },
          "upload_id": {
            "title": "Upload Id",
            "type": "string"
          }
        },
        "required": [
          "upload_id",
          "parts",
          "remaining",
          "expires_at"
        ],
        "title": "IssuedUploadView",
        "type": "object"
      },
      "PurposeUsageView": {
        "properties": {
          "count": {
            "title": "Count",
            "type": "integer"
          },
          "pending_count": {
            "title": "Pending Count",
            "type": "integer"
          },
          "pending_size_bytes": {
            "title": "Pending Size Bytes",
            "type": "integer"
          },
          "purpose": {
            "$ref": "#/components/schemas/FilePurpose"
          },
          "size_bytes": {
            "title": "Size Bytes",
            "type": "integer"
          }
        },
        "required": [
          "purpose",
          "count",
          "size_bytes",
          "pending_count",
          "pending_size_bytes"
        ],
        "title": "PurposeUsageView",
        "type": "object"
      },
      "StorageUsageView": {
        "description": "What the org keeps in the store, counted from its files: the stored ones\nper purpose and in total, and the uploads started and not yet confirmed.\nA removed file stops counting at once.",
        "properties": {
          "pending_size_bytes": {
            "title": "Pending Size Bytes",
            "type": "integer"
          },
          "purposes": {
            "items": {
              "$ref": "#/components/schemas/PurposeUsageView"
            },
            "title": "Purposes",
            "type": "array"
          },
          "total_count": {
            "title": "Total Count",
            "type": "integer"
          },
          "total_size_bytes": {
            "title": "Total Size Bytes",
            "type": "integer"
          }
        },
        "required": [
          "purposes",
          "total_count",
          "total_size_bytes",
          "pending_size_bytes"
        ],
        "title": "StorageUsageView",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Tadas API: media",
    "version": "0.18.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/media/files/{file_id}": {
      "get": {
        "operationId": "get_file",
        "parameters": [
          {
            "in": "path",
            "name": "file_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "File Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get File",
        "tags": [
          "media"
        ]
      }
    },
    "/v1/media/files/{file_id}/confirm": {
      "post": {
        "operationId": "confirm_file",
        "parameters": [
          {
            "in": "path",
            "name": "file_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "File Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "upload_refused: the parts the store holds do not sum to the size"
          }
        },
        "summary": "Confirm File",
        "tags": [
          "media"
        ]
      }
    },
    "/v1/media/files/{file_id}/download": {
      "get": {
        "description": "`inline=true` is a preview the page shows; otherwise the link saves the\nfile under its own name.",
        "operationId": "issue_download",
        "parameters": [
          {
            "in": "path",
            "name": "file_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "File Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "inline",
            "required": false,
            "schema": {
              "default": false,
              "title": "Inline",
              "type": "boolean"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssuedDownloadView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Issue Download",
        "tags": [
          "media"
        ]
      }
    },
    "/v1/media/files/{file_id}/upload": {
      "post": {
        "description": "The parts the store does not hold yet. Asked again after an upload\nwas cut off, it signs only the parts still missing, under the same\nupload.",
        "operationId": "issue_upload",
        "parameters": [
          {
            "in": "path",
            "name": "file_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "File Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssuedUploadView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Issue Upload",
        "tags": [
          "media"
        ]
      }
    },
    "/v1/media/usage": {
      "get": {
        "operationId": "get_usage",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StorageUsageView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Usage",
        "tags": [
          "media"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "Media: the org's files, as references to objects in the store.\n\nA file; the parts of an upload the store does not hold yet, each signed for\na PUT straight to the store; the confirm once the parts are there; the link\na download follows straight from the store; and the org's storage used\n(`/v1/media/files/{file_id}`, `.../upload`, `.../confirm`, `.../download`,\n`/v1/media/usage`). No route takes or serves a file's bytes. Each function\nis one call into the media service. A file is started by the namespace it\nbelongs to (a task's attachment by the task's route), never here.",
      "name": "media"
    }
  ]
}
