{
  "components": {
    "schemas": {
      "BillingView": {
        "description": "The org's plan now, where it comes from, and what the org uses of it.\n`ends_at` is set when a paid plan is set to end; the org is on\n`plan_after` from then, and keeps everything it has. `can_manage` says\nwhether the caller may change the plan: an owner or an admin.",
        "properties": {
          "active_tasks": {
            "title": "Active Tasks",
            "type": "integer"
          },
          "can_manage": {
            "title": "Can Manage",
            "type": "boolean"
          },
          "cancel_at_period_end": {
            "title": "Cancel At Period End",
            "type": "boolean"
          },
          "comped_plan": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Plan"
              },
              {
                "type": "null"
              }
            ]
          },
          "current_period_end": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Period End"
          },
          "ends_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ends At"
          },
          "limits": {
            "$ref": "#/components/schemas/PlanLimitsView"
          },
          "monthly_cents": {
            "title": "Monthly Cents",
            "type": "integer"
          },
          "paid_plan": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Plan"
              },
              {
                "type": "null"
              }
            ]
          },
          "payment_failed": {
            "title": "Payment Failed",
            "type": "boolean"
          },
          "plan": {
            "$ref": "#/components/schemas/Plan"
          },
          "plan_after": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Plan"
              },
              {
                "type": "null"
              }
            ]
          },
          "plans": {
            "items": {
              "$ref": "#/components/schemas/PlanOfferView"
            },
            "title": "Plans",
            "type": "array"
          },
          "seats": {
            "title": "Seats",
            "type": "integer"
          },
          "status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SubscriptionStatus"
              },
              {
                "type": "null"
              }
            ]
          },
          "storage_bytes": {
            "title": "Storage Bytes",
            "type": "integer"
          }
        },
        "required": [
          "plan",
          "limits",
          "paid_plan",
          "comped_plan",
          "status",
          "current_period_end",
          "cancel_at_period_end",
          "ends_at",
          "plan_after",
          "seats",
          "active_tasks",
          "storage_bytes",
          "monthly_cents",
          "payment_failed",
          "can_manage",
          "plans"
        ],
        "title": "BillingView",
        "type": "object"
      },
      "CompPlanRequest": {
        "additionalProperties": false,
        "description": "The plan an operator grants without a payment; null, or free, takes\nthe grant back.",
        "properties": {
          "plan": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Plan"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "plan"
        ],
        "title": "CompPlanRequest",
        "type": "object"
      },
      "OpenPortalRequest": {
        "additionalProperties": false,
        "description": "`flow` opens the processor's page on one task and comes back to\n`return_url` when it is done; without it, the page's home.",
        "properties": {
          "flow": {
            "anyOf": [
              {
                "const": "payment_method_update",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Flow"
          },
          "return_url": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Return Url",
            "type": "string"
          }
        },
        "required": [
          "return_url"
        ],
        "title": "OpenPortalRequest",
        "type": "object"
      },
      "OperatorBillingView": {
        "description": "One org's plan, as the operator plane reads it.",
        "properties": {
          "comped_plan": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Plan"
              },
              {
                "type": "null"
              }
            ]
          },
          "ends_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ends At"
          },
          "paid_plan": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Plan"
              },
              {
                "type": "null"
              }
            ]
          },
          "plan": {
            "$ref": "#/components/schemas/Plan"
          },
          "status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SubscriptionStatus"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "plan",
          "paid_plan",
          "comped_plan",
          "status",
          "ends_at"
        ],
        "title": "OperatorBillingView",
        "type": "object"
      },
      "Plan": {
        "enum": [
          "free",
          "pro",
          "team",
          "max"
        ],
        "title": "Plan",
        "type": "string"
      },
      "PlanLimitsView": {
        "description": "A plan's bounds; a null count is no bound.",
        "properties": {
          "active_tasks": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Tasks"
          },
          "api_keys": {
            "title": "Api Keys",
            "type": "boolean"
          },
          "members": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Members"
          },
          "storage_bytes": {
            "title": "Storage Bytes",
            "type": "integer"
          }
        },
        "required": [
          "members",
          "api_keys",
          "active_tasks",
          "storage_bytes"
        ],
        "title": "PlanLimitsView",
        "type": "object"
      },
      "PlanOfferView": {
        "description": "One plan on offer: its bounds and its monthly price. A per-seat plan's\n`flat_cents` covers up to `included_seats` seats, and past them every\nseat is `per_seat_cents`.",
        "properties": {
          "flat_cents": {
            "title": "Flat Cents",
            "type": "integer"
          },
          "included_seats": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Included Seats"
          },
          "limits": {
            "$ref": "#/components/schemas/PlanLimitsView"
          },
          "per_seat_cents": {
            "title": "Per Seat Cents",
            "type": "integer"
          },
          "plan": {
            "$ref": "#/components/schemas/Plan"
          }
        },
        "required": [
          "plan",
          "limits",
          "flat_cents",
          "included_seats",
          "per_seat_cents"
        ],
        "title": "PlanOfferView",
        "type": "object"
      },
      "RedirectView": {
        "description": "Where the person goes next: the processor's hosted page.",
        "properties": {
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "RedirectView",
        "type": "object"
      },
      "StartCheckoutRequest": {
        "additionalProperties": false,
        "description": "`return_url` is the portal page the person comes back to, paid or not;\nit is one of the portal's own origins, or the request is refused.",
        "properties": {
          "plan": {
            "$ref": "#/components/schemas/Plan"
          },
          "return_url": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Return Url",
            "type": "string"
          }
        },
        "required": [
          "plan",
          "return_url"
        ],
        "title": "StartCheckoutRequest",
        "type": "object"
      },
      "SubscriptionStatus": {
        "description": "The processor's statuses, as it spells them.",
        "enum": [
          "incomplete",
          "incomplete_expired",
          "trialing",
          "active",
          "past_due",
          "canceled",
          "unpaid",
          "paused"
        ],
        "title": "SubscriptionStatus",
        "type": "string"
      }
    }
  },
  "info": {
    "title": "Tadas API: billing",
    "version": "0.18.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/admin/orgs/{org_id}/billing": {
      "get": {
        "operationId": "get_org_billing",
        "parameters": [
          {
            "in": "path",
            "name": "org_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Org Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperatorBillingView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Org Billing",
        "tags": [
          "billing"
        ]
      }
    },
    "/v1/admin/orgs/{org_id}/plan": {
      "put": {
        "description": "Grants the org a plan with no payment, or takes the grant back. A put:\nthe same body twice leaves the same grant.",
        "operationId": "comp_plan",
        "parameters": [
          {
            "in": "path",
            "name": "org_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Org Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompPlanRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperatorBillingView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Comp Plan",
        "tags": [
          "billing"
        ]
      }
    },
